{
  "dependencies": {
    "bcrypt": "^6.0.0",
    "bullmq": "^5.79.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.21.0",
    "prom-client": "^15.1.3",
    "winston": "^3.19.0",
    "ws": "^8.21.0",
    "zod": "^4.4.3"
  },
  "name": "flowsync",
  "version": "0.1.0",
  "description": "Real-time event processing and workflow automation",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/shared/db/migrate-runner.ts",
    "db:reset": "docker compose down -v && docker compose up -d && sleep 3 && npm run db:migrate",
    "worker:dev": "tsx watch src/workers/worker.ts",
    "worker": "tsx src/workers/worker.ts",
    "ws:dev": "tsx watch src/ws-server.ts",
    "ws": "tsx src/ws-server.ts",
    "test":    "vitest run",
 "test:ci": "vitest run --coverage",
  "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.6.2",
    "@types/pg": "^8.20.0",
    "@types/supertest": "^7.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
