{
  "title": "FlowSync",
  "uid": "flowsync-main",
  "schemaVersion": 38,
  "refresh": "15s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Request Rate (req/sec)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus" },
      "targets": [{
        "expr": "sum(rate(http_requests_total[5m]))",
        "legendFormat": "req/s"
      }]
    },
    {
      "id": 2,
      "title": "Error Rate (%)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 0, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus" },
      "targets": [{
        "expr": "rate(http_requests_total{status_code=~\"5..\"}[5m]) / rate(http_requests_total[5m]) * 100",
        "legendFormat": "5xx %"
      }]
    },
    {
      "id": 3,
      "title": "p95 Latency (seconds)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus" },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le))",
        "legendFormat": "p95"
      }]
    },
    {
      "id": 4,
      "title": "Worker Jobs/sec",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus" },
      "targets": [{
        "expr": "rate(worker_jobs_processed_total[5m])",
        "legendFormat": "{{status}}"
      }]
    },
    {
      "id": 5,
      "title": "Dead Letter Queue",
      "type": "stat",
      "gridPos": { "x": 0, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus" },
      "targets": [{ "expr": "worker_dlq_jobs", "legendFormat": "DLQ" }],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "red",   "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 6,
      "title": "WebSocket Connections",
      "type": "stat",
      "gridPos": { "x": 6, "y": 16, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus" },
      "targets": [{ "expr": "ws_active_connections", "legendFormat": "connections" }]
    },
    {
      "id": 7,
      "title": "Heap Memory (MB)",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 16, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus" },
      "targets": [{
        "expr": "nodejs_heap_size_used_bytes / 1024 / 1024",
        "legendFormat": "heap MB"
      }]
    }
  ]
}